{
   "name": "Omnissa Horizon Client for Chromebook",
   "short_name": "Omnissa Horizon Client",
   "scope": "/",
   "start_url": "/",
   "description": "Omnissa Horizon Client for Chromebook",
   "display": "standalone",
   "display_override": ["borderless"],
   "icons": [
      {
         "src": "/view_16x.png",
         "sizes": "16x16"
      },
      {
         "src": "/view_128x.png",
         "sizes": "128x128"
      },
      {
         "src": "/view_144x.png",
         "sizes": "144x144"
      }
   ],
   "isolated_storage": true,
   "version": "8.17.0.13429",
   "version_name": "8.17.0",
   "permissions_policy": {
      "window-management": ["*"],
      "window-placement": ["*"],
      "cross-origin-isolated": ["self"],
      "controlledframe": ["*"],
      "controlled-frame": ["*"],
      "fullscreen": ["*"],
      "usb": ["*"],
      "clipboard": ["*"],
      "camera": ["*"],
      "audio": ["*"],
      "microphone": ["*"],
      "clipboard-read": ["*"],
      "clipboard-write": ["*"],
      "web-printing": ["*"]
   },
   "protocol_handlers": [
      {
         "protocol": "web+horizon",
         "url": "/?data=%s"
      },
      {
         "protocol": "web+sdk",
         "url": "/bootstrap.html?url=%s"
      }
   ],
   "file_handlers": [
      {
         "action": "/",
         "accept": {
            "text/plain": [".log", ".txt"],
            "image/jpeg": [".jpg", ".jpeg"],
            "image/png": [".png"],
            "image/bmp": [".bmp"],
            "image/x-icon": [".ico"],
            "image/vnd.microsoft.icon": [".ico"],
            "audio/mpeg": [".mp3"],
            "audio/wav": [".wav"],
            "video/mp4": [".mp4"],
            "application/msword": [".doc"],
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [".docx"],
            "application/pdf": [".pdf"],
            "application/vnd.ms-powerpoint": [".ppt"],
            "application/vnd.openxmlformats-officedocument.presentationml.presentation": [".pptx"],
            "application/vnd.ms-excel": [".xls"],
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [".xlsx"],
            "application/vnd.ms-powerpoint.slideshow.macroEnabled.12": [".pps"],
            "application/vnd.openxmlformats-officedocument.presentationml.slideshow": [".ppsx"]
         }
      }
   ],
   "launch_handler": {
      "client_mode": "focus-existing"
   },
   "externally_connectable": {
      "ids": ["*"]
   }
}
